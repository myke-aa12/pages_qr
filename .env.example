# PLANTILLA .env - Copia como .env en el servidor
# ⚠️ REEMPLAZA LOS VALORES CON TUS CREDENCIALES REALES

# Seguridad (genera una nueva clave aleatoria)
SECRET_KEY=tu_clave_secreta_aleatoria_aqui_minimo_32_caracteres

# Base de datos Aiven
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/database
DATABASE_URL=mysql+pymysql://usuario:contraseña@host:puerto/database

# Certificado SSL de Aiven (ruta relativa)
DB_CA_CERT=app/core/ca.pem

# Entorno
FLASK_ENV=production

# 🆕 WhatsApp (cuando agregues el bot)
# WHATSAPP_API_URL=https://graph.instagram.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_id_aqui
# WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
# WHATSAPP_VERIFY_TOKEN=tu_verify_token_aqui
